{
  "features": [
    "novelty_empirical_pre_mean",
    "novelty_empirical_post_mean",
    "insight_pre_mean",
    "insight_post_mean",
    "novelty_empirical_post_max",
    "insight_post_max",
    "repair_scope_pre_mean",
    "repair_scope_post_mean",
    "repair_scope_post_max",
    "concern_pre_severity_max",
    "concern_post_severity_max",
    "insight_weakness_pre_severity_max",
    "insight_weakness_post_severity_max",
    "repair_scope_survival_rate",
    "concern_survival_severity_confidence_weighted_rate",
    "insight_weakness_survival_severity_confidence_weighted_rate",
    "repair_scope_matched_improvement_mean",
    "repair_scope_matched_max_level_improvement",
    "insight_matched_change_mean",
    "novelty_empirical_matched_change_mean",
    "concern_matched_severity_improvement_mean",
    "insight_weakness_matched_severity_improvement_mean"
  ],
  "targets": [
    "wp_cites", "cites", "sjr_score", "sjr_global_rank",
    "sjr_economics_finance_rank", "sjr_best_quartile",
    "gsm_h5_index", "gsm_h5_median", "tier_used_in_experiments",
    "stern_finance_top_tier"
  ],
  "metrics": ["spearman", "kendall_tau_b", "concordance"],
  "derived_features": true,
  "holdout": {"fraction": 0.3, "seed": 12, "stage": "development"},
  "feature_directions": {
    "repair_scope_pre_mean": "lower",
    "repair_scope_post_mean": "lower",
    "repair_scope_post_max": "lower",
    "concern_pre_severity_max": "lower",
    "concern_post_severity_max": "lower",
    "insight_weakness_pre_severity_max": "lower",
    "insight_weakness_post_severity_max": "lower",
    "repair_scope_survival_rate": "lower",
    "concern_survival_severity_confidence_weighted_rate": "lower",
    "insight_weakness_survival_severity_confidence_weighted_rate": "lower"
  },
  "aggregation": {
    "metric": "concordance",
    "validation_folds": 2,
    "min_validation_papers": 5,
    "min_train_papers": 5,
    "seed": 12,
    "candidates": [
      {
        "name": "fixed_post_means",
        "kind": "fixed",
        "weights": {
          "novelty_empirical_post_mean": 1, "insight_post_mean": 1,
          "repair_scope_post_mean": -1
        },
        "standardize": true,
        "bins": {"quantiles": [0.3333333333333333, 0.6666666666666666]}
      },
      {
        "name": "fixed_post_extremes",
        "kind": "fixed",
        "weights": {
          "novelty_empirical_post_max": 1, "insight_post_max": 1,
          "repair_scope_post_max": -1, "concern_post_severity_max": -1,
          "insight_weakness_post_severity_max": -1
        },
        "standardize": true,
        "bins": {"quantiles": [0.3333333333333333, 0.6666666666666666]}
      },
      {
        "name": "ridge_post_levels",
        "kind": "ridge",
        "features": [
          "novelty_empirical_post_mean", "insight_post_mean", "repair_scope_post_mean",
          "concern_post_severity_max", "insight_weakness_post_severity_max"
        ],
        "alpha": 1,
        "bins": {"quantiles": [0.3333333333333333, 0.6666666666666666]}
      },
      {
        "name": "ridge_levels_changes",
        "kind": "ridge",
        "features": [
          "novelty_empirical_post_mean", "insight_post_mean", "repair_scope_post_mean",
          "concern_post_severity_max", "insight_weakness_post_severity_max",
          "repair_scope_matched_improvement_mean", "insight_matched_change_mean",
          "concern_matched_severity_improvement_mean"
        ],
        "alpha": 1,
        "bins": {"quantiles": [0.3333333333333333, 0.6666666666666666]}
      },
      {
        "name": "ridge_levels_changes_regularized",
        "kind": "ridge",
        "features": [
          "novelty_empirical_post_mean", "insight_post_mean", "repair_scope_post_mean",
          "concern_post_severity_max", "insight_weakness_post_severity_max",
          "repair_scope_matched_improvement_mean", "insight_matched_change_mean",
          "concern_matched_severity_improvement_mean"
        ],
        "alpha": 10,
        "bins": {"quantiles": [0.3333333333333333, 0.6666666666666666]}
      },
      {
        "name": "ridge_levels_changes_regularized_binned",
        "kind": "ridge",
        "features": [
          "novelty_empirical_post_mean", "insight_post_mean", "repair_scope_post_mean",
          "concern_post_severity_max", "insight_weakness_post_severity_max",
          "repair_scope_matched_improvement_mean", "insight_matched_change_mean",
          "concern_matched_severity_improvement_mean"
        ],
        "alpha": 10,
        "bins": {"quantiles": [0.3333333333333333, 0.6666666666666666]},
        "representation": "binned"
      }
    ]
  },
  "persona_analysis": true,
  "synthetic": false
}
